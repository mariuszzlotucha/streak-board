---
import { Button } from "@/components/ui/button";

interface Props {
  /** Dev-only: render the message visible; on real pages the service worker script reveals it after an update. */
  visible?: boolean;
}

const { visible = false } = Astro.props;
---

{/* The quiet new-version message. Hidden until `src/lib/pwa/register.ts` sees a release take over an open page; never
role="alert" (smoke keeps alert for errors). "Refresh" reloads only when clicked, so nothing being typed is lost. */}
<div
  data-update-notice
  role="status"
  hidden={!visible}
  class="fixed inset-x-4 bottom-[calc(--spacing(4)+env(safe-area-inset-bottom))] z-50 mx-auto flex max-w-md items-center justify-between gap-4 rounded-lg border border-border bg-background p-4 text-sm text-foreground shadow-lg"
>
  <p>A new version of StreakBoard is available.</p>
  <Button type="button" size="sm" data-update-refresh>
    Refresh
  </Button>
</div>
