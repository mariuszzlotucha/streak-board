---
import { buttonVariants } from "@/components/ui/button";
---

<section class="text-center">
  <h1 class="font-heading text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
    Keep each other on track.
  </h1>
  <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground">
    StreakBoard is a habit tracker for a group of friends. You track the same tasks, mark them done every day or week,
    and see each other's streaks on one shared leaderboard.
  </p>
  <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
    <a href="/auth/signup" class:list={buttonVariants({ size: "lg" })}>
      Sign up
    </a>
    <a href="/auth/signin" class:list={buttonVariants({ variant: "outline", size: "lg" })}>
      Sign in
    </a>
  </div>
</section>
