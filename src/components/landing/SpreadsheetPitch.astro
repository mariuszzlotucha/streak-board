---
import { Card, CardContent } from "@/components/ui/card";
---

<section aria-labelledby="shared-spreadsheet">
  <Card className="mx-auto max-w-3xl">
    <CardContent className="space-y-3 text-center">
      <h2 id="shared-spreadsheet" class="font-heading text-2xl font-semibold text-foreground">
        The shared spreadsheet, without the upkeep
      </h2>
      <p class="text-base leading-relaxed text-muted-foreground">
        If your group ever colored a shared sheet green and red, this is that sheet, kept for you: every task shows who
        did it in each recent day or week. Miss a day — or a week, on a weekly task — and your streak is halved (rounded
        down) rather than reset, so a long run survives a bad day.
      </p>
    </CardContent>
  </Card>
</section>
