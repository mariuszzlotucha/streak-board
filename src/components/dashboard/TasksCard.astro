---
import { Plus, TriangleAlert } from "lucide-react";
import CreateTaskForm from "@/components/tasks/CreateTaskForm";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { participantsResolver } from "@/lib/dashboard-data";
import type { GroupMember } from "@/lib/groups";
import type { Board } from "@/lib/leaderboard-rules";
import type { GroupTask } from "@/lib/tasks";
import { cn } from "@/lib/utils";
import TaskRow from "./TaskRow.astro";

interface Props {
  tasks: GroupTask[];
  members: GroupMember[];
  participantsByTask: Map<string, string[]>;
  participantsFailed: boolean;
  checkoffsFailed: boolean;
  board: Board | null;
  viewerId: string | undefined;
}

const { tasks, members, participantsByTask, participantsFailed, checkoffsFailed, board, viewerId } = Astro.props;
const participantsOf = participantsResolver(participantsByTask, members, viewerId);
// "Add a task" is a native disclosure, styled as an outline button. `inline-flex` drops the list-item marker in Chromium
// and Firefox, `list-none` says so explicitly, and Safari's own marker is a pseudo-element of its own.
const summaryClass = cn(buttonVariants({ variant: "outline" }), "list-none [&::-webkit-details-marker]:hidden");
---

<Card>
  <CardHeader>
    <CardTitle as="h2">Tasks</CardTitle>
    <CardDescription>{`${tasks.length} ${tasks.length === 1 ? "task" : "tasks"}`}</CardDescription>
  </CardHeader>
  <CardContent className="space-y-4">
    {/* Partial failures are notices (`role="status"`), not errors: smoke reserves `role="alert"` for errors. */}
    {participantsFailed && (
      <Alert variant="warning" role="status">
        <TriangleAlert />
        <AlertDescription>Participants are unavailable right now. Reload to try again.</AlertDescription>
      </Alert>
    )}
    {checkoffsFailed && (
      <Alert variant="warning" role="status">
        <TriangleAlert />
        <AlertDescription>
          Streaks are unavailable right now, so tasks can't be marked done and the leaderboard is hidden. Reload to try
          again.
        </AlertDescription>
      </Alert>
    )}
    {tasks.length === 0 ? (
      <p class="text-sm text-muted-foreground">
        No tasks yet. Add something your group wants to do once, every day or every week.
      </p>
    ) : (
      <ul class="divide-y">
        {tasks.map((task) => (
          <TaskRow
            task={task}
            participants={participantsOf(task.id)}
            participantsFailed={participantsFailed}
            viewerTask={board?.viewerTasks.get(task.id)}
            viewerId={viewerId}
          />
        ))}
      </ul>
    )}
    <details open={tasks.length === 0} class="border-t pt-4">
      <summary class:list={summaryClass}>
        <Plus />
        Add a task
      </summary>
      <div class="pt-4">
        <CreateTaskForm client:load />
      </div>
    </details>
  </CardContent>
</Card>
