---
import MembersCard from "@/components/dashboard/MembersCard.astro";
import NoGroupCards from "@/components/dashboard/NoGroupCards.astro";
import PageHeading from "@/components/dashboard/PageHeading.astro";
import PendingInviteCard from "@/components/dashboard/PendingInviteCard.astro";
import TasksCard from "@/components/dashboard/TasksCard.astro";
import Leaderboard from "@/components/tasks/Leaderboard";
import { CircleAlert, TriangleAlert } from "lucide-react";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import type { DashboardData } from "@/lib/dashboard-data";

// The dashboard's body, rendered inside `AppLayout` by `/dashboard` from `loadDashboard` and by the dev kitchen sink from
// fixtures, so the visual gate shows the real view.
interface Props extends DashboardData {
  viewerId: string | undefined;
  inviteLink: string | null;
}

const {
  error,
  group,
  members,
  tasks,
  participantsByTask,
  pendingCode,
  pendingGroupName,
  loadFailed,
  tasksFailed,
  participantsFailed,
  checkoffsFailed,
  board,
  viewerId,
  inviteLink,
} = Astro.props;

const isOwner = group !== null && group.owner_id === viewerId;
---

{loadFailed ? (
  <div class="space-y-4">
    {/* After a failed load we cannot tell whether the user is in a group: only the failure and a way to retry. */}
    <PageHeading title="The dashboard didn't load" description={error ?? undefined} />
    <a href="/dashboard" class:list={buttonVariants()}>
      Try again
    </a>
  </div>
) : (
  <div class="space-y-6">
    {error && (
      <Alert variant="destructive">
        <CircleAlert />
        <AlertDescription>{error}</AlertDescription>
      </Alert>
    )}

    {group && inviteLink ? (
      <>
        <PageHeading eyebrow="Your group" title={group.name} />
        {/* The HTML order is the phone order: the main loop (Tasks, then the Leaderboard) before Members; group settings
            are on `/settings`. From 1024 px Tasks takes three fifths and the right column two fifths. The columns space
            their cards with `gap`: an island's wrapper is `display: contents`, so `space-y` would drop the margin after
            the Leaderboard. */}
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-5">
          <div class="flex min-w-0 flex-col gap-6 lg:col-span-3">
            {/* A failed task load swaps only the Tasks card for this notice; the top alert keeps the generic message. */}
            {tasksFailed ? (
              <Card>
                <CardHeader>
                  <CardTitle as="h2">Tasks</CardTitle>
                </CardHeader>
                <CardContent>
                  <Alert variant="warning" role="status">
                    <TriangleAlert />
                    <AlertDescription>Tasks are unavailable right now. Reload to try again.</AlertDescription>
                  </Alert>
                </CardContent>
              </Card>
            ) : (
              <TasksCard
                tasks={tasks}
                members={members}
                participantsByTask={participantsByTask}
                participantsFailed={participantsFailed}
                checkoffsFailed={checkoffsFailed}
                board={board}
                viewerId={viewerId}
              />
            )}
          </div>
          <div class="flex min-w-0 flex-col gap-6 lg:col-span-2">
            {board && viewerId && <Leaderboard client:load rows={board.totals} viewerId={viewerId} />}
            <MembersCard
              members={members}
              groupName={group.name}
              viewerId={viewerId}
              isOwner={isOwner}
              inviteLink={inviteLink}
            />
          </div>
        </div>
      </>
    ) : pendingCode && pendingGroupName !== null ? (
      <>
        <PendingInviteCard code={pendingCode} groupName={pendingGroupName} />
        <h2 class="font-heading text-xl font-semibold">Or start your own group</h2>
        <NoGroupCards headingLevel={3} />
      </>
    ) : (
      <>
        <PageHeading
          title="Start or join a group"
          description="StreakBoard lets a group share tasks, mark them done every day or week, and compare streaks on a leaderboard."
        />
        <NoGroupCards headingLevel={2} />
      </>
    )}
  </div>
)}
