---
import GridCell from "@/components/tasks/GridCell";
import ViewerGridCell from "@/components/tasks/ViewerGridCell";
import { cellLabelPrefix, periodHeader } from "@/lib/grid-labels";
import type { TaskGrid } from "@/lib/grid-rules";
import type { TaskRecurrence } from "@/lib/task-rules";

interface Props {
  taskId: string;
  title: string;
  recurrence: TaskRecurrence;
  grid: TaskGrid;
}

const { taskId, title, recurrence, grid } = Astro.props;
const current = grid.periods.length - 1;
---

{/* A table, never a list: the smoke row regexes stop at the first </li>. From 360 px nothing scrolls sideways; below
    that only the wrapper does, never the page. The wrapper is positioned so the cells' sr-only labels (absolute) are
    clipped with it and cannot widen the page. The header columns are 28 px (w-7, daily) and 48 px (w-12, weekly and
    once), the width budget of the lines periodHeader returns in src/lib/grid-labels.ts. Only the viewer's current
    cell is an island: it follows the row's tick at once. */}
<div class="relative max-w-full overflow-x-auto">
  <table
    aria-label={`Check-offs of ${title}`}
    class="border-separate border-spacing-1 text-xs max-sm:border-spacing-0.5"
  >
    <caption class="sr-only">{`Check-offs of ${title}`}</caption>
    <thead>
      <tr>
        <th scope="col">
          <span class="sr-only">Participant</span>
        </th>
        {grid.periods.map((period) => (
          <th
            scope="col"
            class:list={["px-0.5 font-normal text-muted-foreground", recurrence === "daily" ? "w-7" : "w-12"]}
          >
            {periodHeader(recurrence, period).map((line) => (
              <span class="block whitespace-nowrap">{line}</span>
            ))}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {grid.rows.map((row) => {
        const name = row.nickname ?? "Unknown member";
        return (
          <tr>
            <th scope="row" class="pr-2 text-left font-normal">
              <span
                class:list={[
                  "line-clamp-2 max-w-14 min-w-14 text-foreground wrap-anywhere sm:max-w-32",
                  row.isYou && "font-medium",
                ]}
              >
                {name}
              </span>
              {row.isYou && <span class="sr-only"> (you)</span>}
            </th>
            {row.cells.map((state, index) => {
              const labelPrefix = cellLabelPrefix(name, recurrence, grid.periods[index]);
              return (
                <td class="p-0">
                  {row.isYou && index === current ? (
                    <ViewerGridCell client:load taskId={taskId} initialState={state} labelPrefix={labelPrefix} />
                  ) : (
                    <GridCell state={state} labelPrefix={labelPrefix} />
                  )}
                </td>
              );
            })}
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
