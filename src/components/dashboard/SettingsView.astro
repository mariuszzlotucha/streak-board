---
import AccountCard from "@/components/dashboard/AccountCard.astro";
import GroupSettingsCard from "@/components/dashboard/GroupSettingsCard.astro";
import PageHeading from "@/components/dashboard/PageHeading.astro";
import RemindersCard from "@/components/dashboard/RemindersCard.astro";
import Toast from "@/components/site/Toast.astro";
import { buttonVariants } from "@/components/ui/button";
import type { GroupMember, MyGroup } from "@/lib/groups";
import { UNKNOWN_MEMBER } from "@/lib/leaderboard-rules";
import type { InstallOffer } from "@/lib/pwa/install";
import type { PushState } from "@/lib/pwa/push";
import type { RemindersData } from "@/lib/settings-data";

// The settings page's body, rendered inside `AppLayout` by `/settings` from `loadSettings` and by the dev kitchen sink
// from fixtures. Rename, transfer, delete and leave still redirect to `/dashboard`, where their `?error=` alert shows, and
// so does a refused account deletion (a deleted account ends signed out on the landing page).
interface Props {
  group: MyGroup | null;
  /** The members of the group (empty without one): the owner hands the group over to one of the others. */
  members: GroupMember[];
  viewerId: string | undefined;
  loadFailed: boolean;
  /** The fixed message of a failed load. */
  error: string | null;
  /** The fixed message of a `?notice=` code (a nickname change ends here), shown as a success toast. */
  notice: string | null;
  /** The signed-in user's own address, shown only here, on the Account card. */
  email: string | undefined;
  nickname: string | null;
  /** The VAPID key and whether the account has any push subscription, for the Reminders card. */
  reminders: RemindersData;
  /** Only the dev kitchen sink pins the device's reminders state. */
  remindersState?: PushState;
  /** Only the dev kitchen sink pins the install offer shown in the Reminders card. */
  installOffer?: InstallOffer;
}

const {
  group,
  members,
  viewerId,
  loadFailed,
  error,
  notice,
  email,
  nickname,
  reminders,
  remindersState,
  installOffer,
} = Astro.props;
const otherMembers = members.filter((member) => member.user_id !== viewerId);
// Members are named by nickname, never by e-mail address.
const nameOf = (member: GroupMember | undefined) => member?.nickname ?? UNKNOWN_MEMBER;
// What deleting the account does to the viewer's group, for the Account card's dialog.
const deletion =
  group === null
    ? ({ kind: "no-group" } as const)
    : group.owner_id !== viewerId
      ? ({
          kind: "member",
          groupName: group.name,
          ownerName: nameOf(members.find((member) => member.user_id === group.owner_id)),
        } as const)
      : otherMembers.length === 0
        ? ({ kind: "sole-owner", groupName: group.name } as const)
        : ({
            kind: "owner",
            groupName: group.name,
            successors: otherMembers.map((member) => ({ value: member.user_id, label: nameOf(member) })),
          } as const);
---

{loadFailed ? (
  <div class="space-y-4">
    {/* After a failed load we cannot tell whether the user is in a group: only the failure and a way to retry. */}
    <PageHeading title="Settings didn't load" description={error ?? undefined} />
    <a href="/settings" class:list={buttonVariants()}>
      Try again
    </a>
  </div>
) : (
  <>
    {/* The toast is fixed to the bottom of the screen; in the markup it comes first, before the page's <h1>, and
        outside the `space-y` stack, whose margin would shift its fixed position. */}
    {notice !== null && <Toast message={notice} variant="success" />}
    <div class="space-y-6">
      <PageHeading title="Settings" />
      <div class="max-w-xl space-y-6">
        {group ? (
          <GroupSettingsCard groupName={group.name} isOwner={group.owner_id === viewerId} otherMembers={otherMembers} />
        ) : (
          <p class="text-muted-foreground">
            You are not in a group yet.{" "}
            <a href="/dashboard" class="font-medium text-foreground underline underline-offset-4">
              Create or join a group
            </a>{" "}
            on your dashboard.
          </p>
        )}
        <RemindersCard
          vapidPublicKey={reminders.vapidPublicKey}
          hasSubscriptions={reminders.hasSubscriptions}
          fixedState={remindersState}
          installOffer={installOffer}
        />
        <AccountCard email={email} nickname={nickname} deletion={deletion} />
      </div>
    </div>
  </>
)}
