---
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";

interface Props {
  code: string;
  groupName: string;
}

const { code, groupName } = Astro.props;
---

{/* The page's one decision: its title is the <h1>, and its button is the only "Join group" on the page. */}
<Card>
  <CardHeader>
    <CardTitle as="h1" className="break-words">
      Join {groupName}?
    </CardTitle>
    <CardDescription>You were invited with a link. Confirm to become a member.</CardDescription>
  </CardHeader>
  <CardContent>
    <form method="POST" action="/api/groups/join">
      <input type="hidden" name="code" value={code} />
      <Button type="submit" className="w-full sm:w-auto">
        Join group
      </Button>
    </form>
  </CardContent>
</Card>
