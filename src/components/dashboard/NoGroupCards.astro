---
import CreateGroupForm from "@/components/groups/CreateGroupForm";
import JoinGroupForm from "@/components/groups/JoinGroupForm";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";

interface Props {
  /** 2 under the page's own <h1>, 3 under the pending invite's "Or start your own group". */
  headingLevel: 2 | 3;
}

const { headingLevel } = Astro.props;
const heading = headingLevel === 2 ? "h2" : "h3";
---

<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
  <Card>
    <CardHeader>
      <CardTitle as={heading}>Create a group</CardTitle>
      <CardDescription>Start a group and invite others with a link.</CardDescription>
    </CardHeader>
    <CardContent>
      <CreateGroupForm client:load />
    </CardContent>
  </Card>

  <Card>
    <CardHeader>
      <CardTitle as={heading}>Join a group</CardTitle>
      <CardDescription>
        Have an invite? Paste the link or code. Using the installed app? Copy the invite link and paste it here.
      </CardDescription>
    </CardHeader>
    <CardContent>
      <JoinGroupForm client:load />
    </CardContent>
  </Card>
</div>
