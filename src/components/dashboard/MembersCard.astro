---
import ConfirmAction from "@/components/groups/ConfirmAction";
import CopyInviteLink from "@/components/groups/CopyInviteLink";
import { Badge } from "@/components/ui/badge";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import type { GroupMember } from "@/lib/groups";
import { UNKNOWN_MEMBER } from "@/lib/leaderboard-rules";

interface Props {
  members: GroupMember[];
  groupName: string;
  viewerId: string | undefined;
  /** The owner sees a Remove action on every other member. */
  isOwner: boolean;
  inviteLink: string;
}

const { members, groupName, viewerId, isOwner, inviteLink } = Astro.props;
// Alone in the group, the invite is the next step: its sentence says so and the Copy button is the filled one.
const soleMember = members.length === 1;
---

<Card>
  <CardHeader>
    <CardTitle as="h2">Members</CardTitle>
    <CardDescription>{`${members.length} ${members.length === 1 ? "member" : "members"}`}</CardDescription>
  </CardHeader>
  <CardContent className="space-y-4">
    <ul class="divide-y">
      {members.map((member) => (
        <li class="flex flex-wrap items-center gap-x-2 gap-y-1 py-2 first:pt-0 last:pb-0">
          <span class="min-w-0 text-sm break-all">{member.nickname ?? UNKNOWN_MEMBER}</span>
          {member.is_owner && <Badge variant="secondary">Owner</Badge>}
          {member.user_id === viewerId && <Badge variant="outline">You</Badge>}
          {isOwner && member.user_id !== viewerId && (
            <div class="ml-auto">
              <ConfirmAction
                client:load
                action="/api/groups/remove-member"
                fields={{ user_id: member.user_id }}
                triggerLabel="Remove"
                triggerAriaLabel={`Remove ${member.nickname ?? "this member"} from the group`}
                title="Remove this member?"
                description={`${member.nickname ?? "This member"} will lose access to ${groupName}, and their streaks in its tasks will be lost. They can rejoin later with the invite link.`}
                confirmLabel="Remove member"
                triggerVariant="ghost"
              />
            </div>
          )}
        </li>
      ))}
    </ul>
    <div class="space-y-2 border-t pt-4">
      {soleMember ? (
        <p class="text-sm text-muted-foreground">
          You're the only member so far. Share this invite link so others can join.
        </p>
      ) : (
        <p class="text-sm text-muted-foreground">Share this invite link to add people to your group.</p>
      )}
      <CopyInviteLink client:load url={inviteLink} emphasis={soleMember} />
      <p class="text-sm text-muted-foreground">
        Friends with the installed app can paste this link under Join with code.
      </p>
    </div>
  </CardContent>
</Card>
