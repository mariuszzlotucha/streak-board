---
import AppLayout from "@/layouts/AppLayout.astro";
import DashboardView from "@/components/dashboard/DashboardView.astro";
import ClearErrorParam from "@/components/site/ClearErrorParam.astro";
import { loadDashboard } from "@/lib/dashboard-data";
import { reportError, requestFields } from "@/lib/log";
import { resolveNotice } from "@/lib/notices";
import { joinPendingInvite } from "@/lib/pending-invite";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;

// A pending invite (opened link, or the code stored at sign-up) joins at once: no "Join group" click.
const inviteSupabase = user ? createClient(Astro.request.headers, Astro.cookies) : null;
if (user && inviteSupabase) {
  try {
    const target = await joinPendingInvite(inviteSupabase, Astro.cookies, user, requestFields(Astro));
    if (target) return Astro.redirect(target);
  } catch (error) {
    // The dashboard still renders; its "Join <group>?" card offers the invite again.
    reportError("groups.invite.exception", error, requestFields(Astro));
  }
}

const {
  error,
  group,
  members,
  tasks,
  participantsByTask,
  pendingCode,
  pendingGroupName,
  loadFailed,
  tasksFailed,
  participantsFailed,
  checkoffsFailed,
  board,
  grids,
} = await loadDashboard({
  createSupabase: () => createClient(Astro.request.headers, Astro.cookies),
  cookies: Astro.cookies,
  user,
  errorParam: Astro.url.searchParams.get("error"),
  log: requestFields(Astro),
});

// G5: a dashboard that could not be loaded answers 503 (with the error page); the partial failures stay 200.
if (loadFailed) Astro.response.status = 503;

const inviteLink = group ? `${Astro.url.origin}/join/${group.join_code}` : null;
// A completed action's `?notice=` code; an unknown one renders nothing.
const notice = resolveNotice(Astro.url.searchParams.get("notice"));
---

<AppLayout title="Dashboard" nickname={Astro.locals.nickname} current="dashboard">
  <DashboardView
    error={error}
    group={group}
    members={members}
    tasks={tasks}
    participantsByTask={participantsByTask}
    pendingCode={pendingCode}
    pendingGroupName={pendingGroupName}
    loadFailed={loadFailed}
    tasksFailed={tasksFailed}
    participantsFailed={participantsFailed}
    checkoffsFailed={checkoffsFailed}
    board={board}
    grids={grids}
    viewerId={user?.id}
    inviteLink={inviteLink}
    notice={notice}
  />
  <ClearErrorParam />
</AppLayout>
