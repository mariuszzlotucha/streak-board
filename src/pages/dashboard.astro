---
import Layout from "@/layouts/Layout.astro";
import CreateGroupForm from "@/components/groups/CreateGroupForm";
import JoinGroupForm from "@/components/groups/JoinGroupForm";
import CopyInviteLink from "@/components/groups/CopyInviteLink";
import ConfirmAction from "@/components/groups/ConfirmAction";
import RenameGroupForm from "@/components/groups/RenameGroupForm";
import { CircleAlert } from "lucide-react";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { createClient } from "@/lib/supabase";
import { groupErrorMessage, resolveGroupError } from "@/lib/group-errors";
import { getMyGroup, listGroupMembers, previewGroup, type GroupMember, type MyGroup } from "@/lib/groups";
import { clearJoinCode, peekJoinCode } from "@/lib/join-code";

const { user } = Astro.locals;

let error = resolveGroupError(Astro.url.searchParams.get("error"));
let group: MyGroup | null = null;
let members: GroupMember[] = [];
let pendingCode: string | null = null;
let pendingGroupName: string | null = null;
let loadFailed = false;

try {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (supabase) {
    group = await getMyGroup(supabase);
    if (group) {
      members = await listGroupMembers(supabase, group.id);
    }
    const code = peekJoinCode(Astro.cookies);
    if (code) {
      if (group) {
        // Already in a group: the pending invite cannot be used.
        clearJoinCode(Astro.cookies);
        error = groupErrorMessage("already_in_group");
      } else {
        const name = await previewGroup(supabase, code);
        if (name === null) {
          clearJoinCode(Astro.cookies);
          error = groupErrorMessage("invalid_code");
        } else {
          pendingCode = code;
          pendingGroupName = name;
        }
      }
    }
  }
} catch (loadError) {
  // eslint-disable-next-line no-console -- server-side log; the user only sees the fixed message
  console.error("Loading the dashboard failed", loadError);
  error = groupErrorMessage("unknown");
  loadFailed = true;
}

const inviteLink = group ? `${Astro.url.origin}/join/${group.join_code}` : null;
const isOwner = group !== null && group.owner_id === user?.id;
// After a failed load we cannot tell whether the user is in a group, so do not offer to create or join one.
const showGroupForms = !group && !loadFailed;
---

<Layout title="Dashboard">
  <div class="flex min-h-screen items-center justify-center bg-muted p-4">
    <div class="w-full max-w-md space-y-4">
      {error && (
        <Alert variant="destructive">
          <CircleAlert />
          <AlertDescription>{error}</AlertDescription>
        </Alert>
      )}

      {group && inviteLink && (
        <Card>
          <CardHeader>
            <CardDescription>Your group</CardDescription>
            <CardTitle>
              <h1 class="font-heading text-2xl font-semibold break-words">{group.name}</h1>
            </CardTitle>
          </CardHeader>
          <CardContent className="space-y-2">
            <p class="text-sm text-muted-foreground">Share this invite link to add people to your group.</p>
            <CopyInviteLink client:load url={inviteLink} />
          </CardContent>
        </Card>
      )}

      {group && (
        <Card>
          <CardHeader>
            <CardTitle>
              <h2 class="font-heading text-xl font-semibold">Members</h2>
            </CardTitle>
            <CardDescription>
              {members.length} {members.length === 1 ? "member" : "members"}
            </CardDescription>
          </CardHeader>
          <CardContent>
            <ul class="divide-y">
              {members.map((member) => (
                <li class="flex flex-wrap items-center gap-x-2 gap-y-1 py-2 first:pt-0 last:pb-0">
                  <span class="min-w-0 text-sm break-all">{member.email ?? "Unknown member"}</span>
                  {member.is_owner && (
                    <span class="rounded-full bg-secondary px-2 py-0.5 text-xs font-medium text-secondary-foreground">
                      Owner
                    </span>
                  )}
                  {member.user_id === user?.id && (
                    <span class="rounded-full border px-2 py-0.5 text-xs font-medium text-muted-foreground">You</span>
                  )}
                </li>
              ))}
            </ul>
          </CardContent>
        </Card>
      )}

      {group && isOwner && (
        <Card>
          <CardHeader>
            <CardTitle>
              <h2 class="font-heading text-xl font-semibold">Rename group</h2>
            </CardTitle>
          </CardHeader>
          <CardContent>
            <RenameGroupForm client:load name={group.name} />
          </CardContent>
        </Card>
      )}

      {group && !isOwner && (
        <Card>
          <CardHeader>
            <CardTitle>
              <h2 class="font-heading text-xl font-semibold">Leave group</h2>
            </CardTitle>
            <CardDescription>You will lose access to this group. You can rejoin with the invite link.</CardDescription>
          </CardHeader>
          <CardContent>
            <ConfirmAction
              client:load
              action="/api/groups/leave"
              triggerLabel="Leave group"
              title="Leave this group?"
              description={`You will no longer be a member of ${group.name}. You can rejoin later with the invite link.`}
              confirmLabel="Leave group"
            />
          </CardContent>
        </Card>
      )}

      {!group && pendingCode && pendingGroupName !== null && (
        <Card>
          <CardHeader>
            <CardTitle>
              <h2 class="font-heading text-xl font-semibold break-words">Join {pendingGroupName}?</h2>
            </CardTitle>
            <CardDescription>You were invited with a link. Confirm to become a member.</CardDescription>
          </CardHeader>
          <CardContent>
            <form method="POST" action="/api/groups/join">
              <input type="hidden" name="code" value={pendingCode} />
              <Button type="submit" className="w-full">
                Join group
              </Button>
            </form>
          </CardContent>
        </Card>
      )}

      {showGroupForms && (
        <Card>
          <CardHeader>
            <CardTitle>
              <h1 class="font-heading text-xl font-semibold">Create a group</h1>
            </CardTitle>
            <CardDescription>Start a group and invite others with a link.</CardDescription>
          </CardHeader>
          <CardContent>
            <CreateGroupForm client:load />
          </CardContent>
        </Card>
      )}

      {showGroupForms && (
        <Card>
          <CardHeader>
            <CardTitle>
              <h2 class="font-heading text-xl font-semibold">Join a group</h2>
            </CardTitle>
            <CardDescription>Have an invite? Paste the link or code.</CardDescription>
          </CardHeader>
          <CardContent>
            <JoinGroupForm client:load />
          </CardContent>
        </Card>
      )}

      <Card size="sm">
        <CardContent className="flex flex-wrap items-center justify-between gap-3">
          <p class="text-sm text-muted-foreground">
            Signed in as <span class="font-semibold text-foreground break-all">{user?.email}</span>
          </p>
          <form method="POST" action="/api/auth/signout">
            <Button type="submit" variant="outline" size="sm">
              Sign out
            </Button>
          </form>
        </CardContent>
      </Card>
    </div>
  </div>
</Layout>
