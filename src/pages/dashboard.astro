---
import AppLayout from "@/layouts/AppLayout.astro";
import DashboardView from "@/components/dashboard/DashboardView.astro";
import { loadDashboard } from "@/lib/dashboard-data";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;

const {
  error,
  group,
  members,
  tasks,
  participantsByTask,
  pendingCode,
  pendingGroupName,
  loadFailed,
  tasksFailed,
  participantsFailed,
  checkoffsFailed,
  board,
} = await loadDashboard({
  createSupabase: () => createClient(Astro.request.headers, Astro.cookies),
  cookies: Astro.cookies,
  user,
  errorParam: Astro.url.searchParams.get("error"),
});

// G5: a dashboard that could not be loaded answers 503 (with the error page); the partial failures stay 200.
if (loadFailed) Astro.response.status = 503;

const inviteLink = group ? `${Astro.url.origin}/join/${group.join_code}` : null;
---

<AppLayout title="Dashboard" email={user?.email} current="dashboard">
  <DashboardView
    error={error}
    group={group}
    members={members}
    tasks={tasks}
    participantsByTask={participantsByTask}
    pendingCode={pendingCode}
    pendingGroupName={pendingGroupName}
    loadFailed={loadFailed}
    tasksFailed={tasksFailed}
    participantsFailed={participantsFailed}
    checkoffsFailed={checkoffsFailed}
    board={board}
    viewerId={user?.id}
    inviteLink={inviteLink}
  />
  {/* Inline so the server HTML carries it (the site sends no CSP). The `?error=` alert shows once: removing the code
      from the address keeps a reload or a shared link from repeating it; other parameters and the hash stay. */}
  <script is:inline>
    {
      const url = new URL(window.location.href);
      if (url.searchParams.has("error")) {
        url.searchParams.delete("error");
        window.history.replaceState(window.history.state, "", url);
      }
    }
  </script>
</AppLayout>
