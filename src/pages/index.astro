---
import PublicLayout from "@/layouts/PublicLayout.astro";
import Hero from "@/components/landing/Hero.astro";
import HowItWorks from "@/components/landing/HowItWorks.astro";
import SpreadsheetPitch from "@/components/landing/SpreadsheetPitch.astro";
import { buttonVariants } from "@/components/ui/button";
import { landingRedirect } from "@/lib/landing";

const redirectTo = landingRedirect(Astro.locals.user !== null, Astro.url);
if (redirectTo) return Astro.redirect(redirectTo);
---

<PublicLayout>
  <Fragment slot="actions">
    <a href="/auth/signin" class:list={buttonVariants({ variant: "ghost", size: "sm" })}>
      Sign in
    </a>
    <a href="/auth/signup" class:list={buttonVariants({ size: "sm" })}>
      Sign up
    </a>
  </Fragment>

  <div class="mx-auto w-full max-w-5xl space-y-16 px-4 py-14 sm:py-20">
    <Hero />
    <HowItWorks />
    <SpreadsheetPitch />
  </div>
</PublicLayout>
