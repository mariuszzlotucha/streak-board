---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import { Card, CardContent, CardFooter, CardHeader } from "@/components/ui/card";
import { buttonVariants } from "@/components/ui/button";
import { resolveSignInError } from "@/lib/auth-errors";
import { takeRememberedEmail } from "@/lib/auth-email";

const error = resolveSignInError(Astro.url.searchParams.get("error"));
// Always consumed so the cookie never outlives one page view; only shown next to an error.
const rememberedEmail = takeRememberedEmail(Astro.cookies);
---

<Layout title="Sign in">
  <div class="flex min-h-screen items-center justify-center bg-muted p-4">
    <Card className="w-full max-w-sm">
      <CardHeader>
        <h1 class="font-heading text-center text-2xl font-semibold">Sign in</h1>
      </CardHeader>
      <CardContent>
        <SignInForm serverError={error} defaultEmail={error ? rememberedEmail : ""} client:load />
      </CardContent>
      <CardFooter className="justify-center text-sm text-muted-foreground">
        Don't have an account?
        <a href="/auth/signup" class:list={buttonVariants({ variant: "link", size: "sm" })}>
          Sign up
        </a>
      </CardFooter>
    </Card>
  </div>
</Layout>
