---
import PublicLayout from "@/layouts/PublicLayout.astro";
import { Card, CardContent, CardFooter, CardHeader } from "@/components/ui/card";
import { buttonVariants } from "@/components/ui/button";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: "Registration successful",
      description: "Your account has been created. You can now sign in.",
      linkText: "Go to sign in",
    }
  : {
      emoji: "📧",
      heading: "Check your email",
      description: "We've sent a confirmation link to your email address. Click it to activate your account.",
      linkText: "Back to sign in",
    };
---

<PublicLayout title={content.heading}>
  <div class="flex flex-1 items-center justify-center p-4">
    <Card className="w-full max-w-sm text-center">
      <CardHeader>
        <div class="text-5xl" aria-hidden="true">
          {content.emoji}
        </div>
        <h1 class="font-heading text-2xl font-semibold">{content.heading}</h1>
      </CardHeader>
      <CardContent className="text-muted-foreground">
        <p>{content.description}</p>
      </CardContent>
      <CardFooter className="justify-center">
        <a href="/auth/signin" class:list={buttonVariants({ variant: "link", size: "sm" })}>
          {content.linkText}
        </a>
      </CardFooter>
    </Card>
  </div>
</PublicLayout>
