---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { Card, CardContent, CardFooter, CardHeader } from "@/components/ui/card";
import { buttonVariants } from "@/components/ui/button";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign up">
  <div class="flex min-h-screen items-center justify-center bg-muted p-4">
    <Card className="w-full max-w-sm">
      <CardHeader>
        <h1 class="font-heading text-center text-2xl font-semibold">Sign up</h1>
      </CardHeader>
      <CardContent>
        <SignUpForm serverError={error} client:load />
      </CardContent>
      <CardFooter className="justify-center text-sm text-muted-foreground">
        Already have an account?
        <a href="/auth/signin" class:list={buttonVariants({ variant: "link", size: "sm" })}>
          Sign in
        </a>
      </CardFooter>
    </Card>
  </div>
</Layout>
