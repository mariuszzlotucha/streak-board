---
import PublicLayout from "@/layouts/PublicLayout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import GoogleButton from "@/components/auth/GoogleButton.astro";
import { Card, CardContent, CardFooter, CardHeader } from "@/components/ui/card";
import { buttonVariants } from "@/components/ui/button";
import { resolveSignUpError } from "@/lib/auth-errors";
import { takeRememberedEmail } from "@/lib/auth-email";

const error = resolveSignUpError(Astro.url.searchParams.get("error"));
// Always consumed so the cookie never outlives one page view; only shown next to an error.
const rememberedEmail = takeRememberedEmail(Astro.cookies);
const serverError = error && !error.field ? error.message : null;
const serverFieldErrors = error?.field ? { [error.field]: error.message } : {};
const policyLink = "font-medium text-primary underline-offset-4 hover:underline";
// Kept in one expression so the phrase the smoke test pins can never be split by reformatting.
const EMAIL_VISIBILITY = "Members of your group will see your e-mail address.";
---

<PublicLayout title="Sign up">
  <div class="flex flex-1 items-center justify-center p-4">
    <Card className="w-full max-w-sm">
      <CardHeader>
        <h1 class="font-heading text-center text-2xl font-semibold">Sign up</h1>
      </CardHeader>
      <CardContent>
        <GoogleButton />
        <SignUpForm
          serverError={serverError}
          serverFieldErrors={serverFieldErrors}
          defaultEmail={error ? rememberedEmail : ""}
          client:load
        />
        <p class="mt-4 text-center text-sm text-muted-foreground">
          {EMAIL_VISIBILITY} Our{" "}
          <a href="/privacy" class:list={policyLink}>
            Privacy Policy
          </a>{" "}
          explains who sees what.
        </p>
      </CardContent>
      <CardFooter className="justify-center text-sm text-muted-foreground">
        Already have an account?
        <a href="/auth/signin" class:list={buttonVariants({ variant: "link", size: "sm" })}>
          Sign in
        </a>
      </CardFooter>
    </Card>
  </div>
</PublicLayout>
