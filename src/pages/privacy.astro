---
import PublicLayout from "@/layouts/PublicLayout.astro";
import { Card, CardContent } from "@/components/ui/card";
import WhoWeAre from "@/components/privacy/WhoWeAre.astro";
import WhatWeCollect from "@/components/privacy/WhatWeCollect.astro";
import LegalBasis from "@/components/privacy/LegalBasis.astro";
import WhoCanSee from "@/components/privacy/WhoCanSee.astro";
import Providers from "@/components/privacy/Providers.astro";
import Retention from "@/components/privacy/Retention.astro";
import Cookies from "@/components/privacy/Cookies.astro";
import YourRights from "@/components/privacy/YourRights.astro";
import AccountDeletion from "@/components/privacy/AccountDeletion.astro";
import ProvidingData from "@/components/privacy/ProvidingData.astro";
import Changes from "@/components/privacy/Changes.astro";
import { p } from "@/components/privacy/styles";

// Every statement in the sections below must stay true for the code as it is: a change to the data model, to who sees
// what, to deletion, to the cookies or to the providers updates this policy in the same change (CLAUDE.md,
// Conventions). Each section is its own component in src/components/privacy/.
---

<PublicLayout title="Privacy Policy">
  <div class="mx-auto w-full max-w-3xl px-4 py-10 sm:py-14">
    <Card>
      <CardContent className="text-base text-muted-foreground">
        <h1 class="font-heading text-3xl font-semibold text-foreground">Privacy Policy</h1>
        <p class="mt-2 text-sm">
          Last updated: <time datetime="2026-10-08">8 October 2026</time>
        </p>
        <p class:list={p}>
          This page explains what StreakBoard collects about you, why, who can see it, how long it is kept and what you
          can ask us to do with it.
        </p>

        <WhoWeAre />
        <WhatWeCollect />
        <LegalBasis />
        <WhoCanSee />
        <Providers />
        <Retention />
        <Cookies />
        <YourRights />
        <AccountDeletion />
        <ProvidingData />
        <Changes />
      </CardContent>
    </Card>
  </div>
</PublicLayout>
