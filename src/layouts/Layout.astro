---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import UpdateNotice from "@/components/site/UpdateNotice.astro";
import { missingConfigs } from "@/lib/config-status";
import { THEME_COLOR } from "@/lib/site";

interface Props {
  title?: string;
  /** Dev-only: renders the new-version message visible (the kitchen sink's `update-notice` state). */
  showUpdateNotice?: boolean;
}

const { title = "StreakBoard — shared habit streaks for your group", showUpdateNotice = false } = Astro.props;
const pageTitle = title.startsWith("StreakBoard") ? title : `${title} · StreakBoard`;
const description =
  "StreakBoard lets a group track the same tasks together, check them off every day or week, and compare streaks on a shared leaderboard.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content={THEME_COLOR} />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="StreakBoard" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    {missingConfigs.map((cfg) => (
      <Banner variant="error">
        <strong>Uwaga:</strong> {cfg.message}
        {cfg.docsUrl && (
          <>
            {" "}
            <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
              {cfg.docsLabel ?? "Dokumentacja"}
            </a>
            .
          </>
        )}
      </Banner>
    ))}
    <slot />
    <UpdateNotice visible={showUpdateNotice} />
    <script>
      import { startServiceWorker } from "@/lib/pwa/register";
      startServiceWorker();
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
